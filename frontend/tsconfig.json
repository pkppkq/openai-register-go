{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    // The wailsjs/ bindings are GENERATED by `wails build`; type-checking them
    // would fail the build on codegen style, not on our code.
    "checkJs": false,
    "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "wailsjs/**/*.d.ts"],
  // The suite imports `<script module>` exports by name — `import { parseLine }
  // from '../pages/ImportAccounts.svelte'`. Plain `tsc` cannot do that: it has
  // no Svelte compiler, so every `.svelte` specifier falls through to the
  // `declare module '*.svelte'` shim, which has a default export and nothing
  // else, and every named import becomes TS2614. svelte-check CAN do it, so
  // the tests are checked there instead — `tsconfig.check.json` is this file
  // without the exclusion, and `npm run check` uses it. Nothing is unchecked;
  // the two configs only differ in WHICH tool sees the tests.
  //
  // Do not "fix" this by moving the module blocks into plain .ts files. They
  // live next to the markup that uses them on purpose, with the app.py line
  // numbers for that screen attached.
  "exclude": ["src/lib/__tests__"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

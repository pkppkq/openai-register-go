/.poc-profile/
*.png
# ...but the Wails app icon is a real source asset the build needs.
!build/appicon.png
/bin/
/dist/
node_modules/

# Wails output
/build/bin/
*.exe

# Vite output. The directory itself must exist for //go:embed all:frontend/dist
# to compile on a fresh clone, hence the tracked .gitkeep below.
/frontend/dist/*
!/frontend/dist/.gitkeep

# NOTE: frontend/wailsjs/ is generated by `wails build` but IS tracked, matching
# the upstream templates — otherwise a fresh clone cannot typecheck or run
# `npm run dev` until someone has run a full Wails build first.

# Wails frontend-install cache marker
/frontend/package.json.md5

# 本地构建、验证和历史归档，不进入源码仓库。
/.cache/
/.tmp/
/_archive/

# H 盘数据迁移副本可能包含账号、Token、代理及支付资料，严禁提交。
/imported-data/

# 旧数据预览命令复用的生产前端副本可由 frontend/dist 重新生成。
/cmd/hdatapreview/frontend/dist/*

# 运行数据与凭据文件绝不能进入源码仓库。
**/state.json
**/state.*.json
**/state_data/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.log
*.zip
*.7z
*.rar
